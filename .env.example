# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# API
API_PORT=4000
CORS_ORIGINS=http://localhost:3000

# Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Gemini AI
GEMINI_API_KEY=

# Serasa Experian — Relatório Avançado PJ (UAT/Produção)
# Auth IAM: /security/iam/v1/client-identities/login (Basic base64(client_id:client_secret))
SERASA_CLIENT_ID=
SERASA_CLIENT_SECRET=
# Opcional: se a Serasa forneceu o Basic pronto (ex: abcd...WXYZ)
# SERASA_IAM_BASIC=
# Ambiente: uat | prod (default: uat)
SERASA_ENV=uat

# CGU — Portal da Transparência (CEIS/CNEP/CEPIM + Trabalho Escravo)
# Cadastro gratuito: https://portaldatransparencia.gov.br/api-de-dados
CGU_API_KEY=

# Allcheck — Localizador (consulta endereço por CNPJ/CPF para clientes e sacados)
ALLCHECK_USER_ID=
ALLCHECK_USER_TOKEN=

# upMiner — Análise de crédito PF/PJ
UPMINER_CLIENT_ID=
UPMINER_CLIENT_SECRET=
UPMINER_BASE_URL=https://upapi-orchestrator.uplexis.com

# CERC — Validação de duplicatas mercantis (cessão de recebíveis)
# Auth: Basic (client_id = CNPJ do participante, client_secret = UUID fornecido pela CERC)
CERC_CLIENT_ID=
CERC_CLIENT_SECRET=
# Token_sustentacao fornecido pela CERC — necessário para a API de operações (gera JWT)
# Sem ele, o Basic auth funciona mas só retorna UUID token (não aceito pela API de operações)
CERC_SUSTAINABILITY_TOKEN=
CERC_BASE_URL=https://de-homolog.cerc.inf.br
