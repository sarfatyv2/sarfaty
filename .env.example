# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# API
API_PORT=4000
CORS_ORIGINS=http://localhost:3000

# Next.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Gemini AI
GEMINI_API_KEY=

# Serasa Experian — Relatório Avançado PJ (UAT/Produção)
# Auth IAM: /security/iam/v1/client-identities/login (Basic base64(client_id:client_secret))
SERASA_CLIENT_ID=
SERASA_CLIENT_SECRET=
# Opcional: se a Serasa forneceu o Basic pronto (ex: abcd...WXYZ)
# SERASA_IAM_BASIC=
# Ambiente: uat | prod (default: uat)
SERASA_ENV=uat

# CGU — Portal da Transparência (CEIS/CNEP/CEPIM + Trabalho Escravo)
# Cadastro gratuito: https://portaldatransparencia.gov.br/api-de-dados
CGU_API_KEY=
