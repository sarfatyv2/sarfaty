# Google Maps (Maps JavaScript API + Geocoding + Street View)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# API (browser + server)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Supabase — Realtime (notifications); same project URL as Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# JWT — must match apps/api JWT_SECRET (HS256 access token verification in middleware)
JWT_SECRET=
