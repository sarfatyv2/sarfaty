{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest build && nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:irpf": "tsx scripts/test-irpf-extraction.ts",
    "test:irpf:classify": "tsx scripts/test-irpf-extraction.ts --no-gemini",
    "test:faturamento": "tsx scripts/test-faturamento-extraction.ts",
    "validate:cnab": "tsx scripts/validate-cnab-parse.ts",
    "db:migrate": "bash scripts/drizzle-migrate.sh"
  },
  "dependencies": {
    "@fastify/helmet": "13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@google/genai": "^1.48.0",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/platform-fastify": "^11.1.18",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nexus/types": "workspace:*",
    "@nexus/utils": "workspace:*",
    "@nexus/validators": "workspace:*",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/nestjs": "^10.47.0",
    "@sentry/profiling-node": "^10.47.0",
    "@supabase/supabase-js": "^2.101.1",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.5.10",
    "multer": "^2.1.1",
    "nestjs-pino": "^4.6.1",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@nexus/config": "workspace:*",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
